{
  "name": "auth-service",
  "version": "1.0.0",
  "description": "Auth Service microservice (register/login/JWT) for a local microservices POC",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "packageManager": "pnpm@10.5.2",
  "main": "dist/server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc",
